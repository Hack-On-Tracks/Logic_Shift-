# RescueVision AI — Environment Configuration

# Google Gemini API Key for AI Rescue Assistant & Criticality Scoring
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite by default, or PostgreSQL: postgresql://user:pass@localhost:5432/rescuevision
DATABASE_URL=sqlite:///./rescuevision.db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Public or Self-hosted OSRM routing base URL
OSRM_BASE_URL=https://router.project-osrm.org

# YOLO Model Name or Path (e.g. yolo26s.pt, yolo11s.pt, yolov8s.pt)
YOLO_MODEL=yolo26s.pt

# Server Port
PORT=8000
